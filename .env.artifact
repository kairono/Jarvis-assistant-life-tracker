# Loaded ONLY by `npm run build:artifact` (vite --mode artifact) and overrides
# .env, so no API keys or personal profile get baked into the published
# artifact HTML. In the artifact, AI/voice/storage come from claude.ai itself.
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=
VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=
VITE_GEMINI_LIVE_MODEL=
VITE_GEMINI_LIVE_API_VERSION=
VITE_GOOGLE_CLIENT_ID=
VITE_USER_PROFILE=
