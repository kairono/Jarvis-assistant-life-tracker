# Copy this file to ".env" and fill in your own values.
# Vite only exposes vars prefixed with VITE_ to the client bundle.
#
# ".env" is git-ignored (see .gitignore), so your real keys and personal
# profile below never get committed or pushed to GitHub.

# Anthropic API key — powers the Jarvis AI assistant (Phase 4).
# Get one at https://console.anthropic.com/. The assistant works without it
# (it just shows a "no key configured" notice), so this is optional for now.
VITE_ANTHROPIC_API_KEY=

# Anthropic model the assistant uses (optional; sensible default if blank).
VITE_ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Free AI providers for the in-chat model picker ---
# Add either (or both) to use the free models. The chat picker only shows
# models whose provider has a key here. Restart the dev server after editing.

# Groq — free, fast. Get a key at https://console.groq.com/keys
VITE_GROQ_API_KEY=

# Google Gemini — free tier. Get a key at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Google OAuth client ID — Google Calendar integration (Phase 3, not built yet).
VITE_GOOGLE_CLIENT_ID=

# The person's whole profile — a SINGLE-LINE JSON string. JARVIS reads this so
# it knows who it's helping. Keep it on one line (dotenv values can't span
# lines). Only "name" is required; every other field is optional.
#
# Full shape (see src/lib/profile.ts for the typed definition):
#   {
#     "name": "Ada Lovelace",
#     "preferredName": "Ada",
#     "age": 32,
#     "dateOfBirth": "1994-12-10",
#     "email": "ada@example.com",
#     "phone": "+1 555 0100",
#     "location": "London, UK",
#     "occupation": "Software engineer",
#     "employer": "Analytical Engines Ltd",
#     "bio": "Building a personal life OS. Training for a half marathon.",
#     "currency": "USD",
#     "timezone": "Europe/London",
#     "health": {
#       "heightCm": 170, "weightKg": 65, "bloodType": "O+",
#       "allergies": ["penicillin"], "conditions": []
#     },
#     "finance": { "annualIncome": 90000, "monthlyBudget": 3000, "bank": "Example Bank" },
#     "preferences": {
#       "interests": ["running", "reading", "mathematics"],
#       "dietaryRestrictions": ["vegetarian"]
#     },
#     "emergencyContact": { "name": "Charles", "relation": "partner", "phone": "+1 555 0123" }
#   }
VITE_USER_PROFILE={"name":"Ada Lovelace","preferredName":"Ada","age":32,"location":"London, UK","occupation":"Software engineer","bio":"Building a personal life OS.","currency":"USD","preferences":{"interests":["running","reading"]}}
